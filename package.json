{
  "name": "gymtrack",
  "productName": "GymTrack",
  "version": "0.1.0",
  "description": "GymTrack – προπόνηση και διατροφή",
  "main": "main.js",
  "author": "demelistasos",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "test": "node tests/unit.test.js && node tests/ui.test.js"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "gr.demelistasos.gymtrack",
    "productName": "GymTrack",
    "files": [
      "main.js",
      "updater.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [{ "target": "zip", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "artifactName": "GymTrack-Windows-${version}.${ext}",
      "extraFiles": [{ "from": "build/ΔΙΑΒΑΣΕ ΜΕ.txt", "to": "ΔΙΑΒΑΣΕ ΜΕ.txt" }]
    },
    "mac": {
      "target": [{ "target": "zip", "arch": ["universal"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.healthcare-fitness",
      "identity": "-",
      "artifactName": "GymTrack-Mac-${version}.${ext}"
    }
  }
}
